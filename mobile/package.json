{
  "name": "coco-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Learn French with Coco - Android and iPhone apps (Capacitor) built from the website files",
  "scripts": {
    "web": "node scripts/copy-web.js",
    "sync": "node scripts/copy-web.js && cap sync",
    "icons": "capacitor-assets generate --iconBackgroundColor '#2B1055' --iconBackgroundColorDark '#2B1055' --splashBackgroundColor '#2B1055' --splashBackgroundColorDark '#2B1055'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
